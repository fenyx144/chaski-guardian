# Clave del modelo de visión (Muse Spark vía API compatible con Chat Completions)
MODEL_API_KEY=
# Base URL del modelo (por defecto la oficial de Meta)
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Acceso al panel del coordinador: credenciales de DEMO publicas; no usar en produccion.
# PANEL_TOKEN es la cadena larga que va en la cookie de sesion (nunca la contrasena).
PANEL_USER=coordinador
PANEL_PASS=demo
PANEL_TOKEN=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=chaski-guardian-dev
